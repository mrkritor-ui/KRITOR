# Built by the Pages workflow on every deploy.
# Committing them would let a stale copy shadow the real source.
/products.json
/shop/*/index.html

# Responsive image renditions and their manifest, built by
# tools/build-images.py. Keeping them out of git is deliberate: the repo holds
# one copy of each painting, not seven, and derivatives can never go stale.
/derived/
/image-manifest.js

node_modules/
__pycache__/
*.pyc
.DS_Store
