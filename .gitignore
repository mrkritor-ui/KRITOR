# Built by the Pages workflow on every deploy.
# Committing them would let a stale copy shadow the real source.
/products.json
/shop/*/index.html
/work-*/

# Responsive image renditions and their manifest, built by
# tools/build-images.py. Keeping them out of git is deliberate: the repo holds
# one copy of each painting, not seven, and derivatives can never go stale.
/derived/
/image-manifest.js

# 1-bit terminal renditions and their manifest, built by
# tools/terminal-images.py. Same rule as above: derivatives are built, never
# committed, so they cannot drift from the paintings they came from.
/derived-1bit/
/terminal-manifest.js

node_modules/
__pycache__/
*.pyc
.DS_Store
